{
  "name": "rapid-results-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Rapid Radar - Lead Digger: finds the right contact at local businesses and exports a CSV.",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dig": "tsx src/cli.ts",
    "check-sources": "tsx src/checkSources.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "fflate": "0.8.2",
    "hyparquet": "1.32.0",
    "hyparquet-compressors": "1.1.2",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
